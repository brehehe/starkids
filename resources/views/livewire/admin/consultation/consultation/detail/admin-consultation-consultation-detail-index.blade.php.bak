                        use Carbon\Carbon;

                        $birthDate = Carbon::parse($transaction->patient->userDetail->birth_date);
                        $now = Carbon::now();

                        $years = $birthDate->diff($now)->y;
                        $months = $birthDate->diff($now)->m;
                        $days = $birthDate->diff($now)->d;
                    @endphp

                    {{ $years }} tahun {{ $months }} bulan {{ $days }} hari
                </p>
